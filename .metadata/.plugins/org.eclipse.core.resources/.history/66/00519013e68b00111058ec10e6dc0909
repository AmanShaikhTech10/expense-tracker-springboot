package com.aman.expensetracker.entity;

public class User {
	package com.aman.expensetracker.entity;

	import javax.persistence.*;

	@Entity
	@Table(name = "users")
	public class User {

	    @Id
	    @GeneratedValue(strategy = GenerationType.IDENTITY)
	    private Long id;

	    private String name;

	    private String email;

	    private String password;

	}

}
